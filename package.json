{
  "name": "ard-trust",
  "version": "0.1.0",
  "description": "Solana-anchored attestation layer for MCP skills and ARD catalog entries. Ship a skill, prove who vouched for it, in one command.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ard-trust": "./dist/src/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/src/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/kit": "^2.1.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "sas-lib": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
