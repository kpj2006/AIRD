# Copy to .env and fill in. Nothing here is uploaded anywhere by the CLI
# itself; only the keypair path is read from disk at runtime.

# The domain whose ai-catalog.json entry you are attesting. The CLI checks
# that this domain's _trust._agents.<domain> TXT record authorizes the
# signer derived from ARD_SOLANA_KEYPAIR before it writes anything.
ARD_PUBLISHER_DOMAIN=acme.com

# The MCP server that serves the skill's skill://index.json / resources.
ARD_MCP_SERVER_URL=https://mcp.acme.com/mcp

# devnet | testnet | mainnet-beta, or a custom RPC URL.
ARD_SOLANA_CLUSTER=devnet

# Path to the Solana keypair used to sign attestations. Must be an
# authorized signer on ARD_SAS_CREDENTIAL (see scripts/bootstrap-credential).
ARD_SOLANA_KEYPAIR=~/.config/solana/id.json

# The SAS Credential (issuer) account this verifier writes attestations
# under. Created once via scripts/bootstrap-credential.ts.
ARD_SAS_CREDENTIAL=

# The SAS Schema this verifier's attestations conform to.
ARD_SAS_SCHEMA=ard.attestation.v1

# Which scan policy to run before attesting. See src/scan.ts.
ARD_SCAN_POLICY=acme-baseline@1.4.0

# Key used to sign the DSSE envelope over the scan result. Reuse the
# Solana keypair, or point at an OIDC-issued token.
ARD_DSSE_KEY=${ARD_SOLANA_KEYPAIR}

# Indexer that watches on-chain attestation/revocation events, so hosts
# with no direct RPC access can still check verdicts.
ARD_INDEXER_URL=https://attest.aossie.org

# If true, `ard-trust verify` subscribes to revocation events instead of
# only checking at load time. See docs on the fail-closed/fail-open rule
# in ard-trust-architecture.md §7.
ARD_REVOCATION_WATCH=true
